# BigWigs packager metadata. .github/workflows/release.yml runs the packager with -m .pkgmeta on every release tag.
# release.yml writes CHANGELOG.md from the newest release's section of NewsContent.lua before running the packager.
package-as: TwintopQOL

manual-changelog:
    filename: CHANGELOG.md
    markup-type: markdown

enable-nolib-creation: no

ignore:
    - build
    - tools
    - dist
    - .github
    - .vscode
    - .claude
    - CLAUDE.md
    - .pkgmeta
